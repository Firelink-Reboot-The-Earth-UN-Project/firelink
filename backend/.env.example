# FireLink backend environment.
# Copy to backend/.env and fill in. Never commit the real .env.

# ── LLM provider (chat models: Help Agent + Recommendation Agent) ──────────
# Required unless OPENAI_BASE_URL is set: used for hosted OpenAI and for
# embeddings (text-embedding-3-small) either way.
OPENAI_API_KEY=

# Optional: point the chat models at any OpenAI-compatible server instead of
# hosted OpenAI. Local servers ignore the API key.
#   Ollama (dev-mode / host venv):  http://localhost:11434/v1
#   Ollama (full docker-compose):    http://host.docker.internal:11434/v1
#   vLLM / LM Studio / llama.cpp:    analogous /v1 endpoints
#OPENAI_BASE_URL=

# Optional model overrides (defaults shown).
#HELP_MODEL=gpt-4o
#RECOMMENDATION_MODEL=gpt-4o-mini

# ── RAG / Pinecone (embeddings use OpenAI) ─────────────────────
PINECONE_API_KEY=
PINECONE_INDEX_NAME=firelink

# ── Infrastructure ─────────────────────────────────────────────────────────
# Docker-compose sets these itself; only needed for hybrid dev-mode.
#DATABASE_URL=sqlite:///app/data/firelink.db
#KAFKA_BOOTSTRAP=localhost:29092
